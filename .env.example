# Linux Docker Compose example. Copy to .env and replace every placeholder.
# Never commit the real .env or paste secrets into shell history.

MYSQL_ROOT_PASSWORD=replace-with-a-strong-password
NEO4J_PASSWORD=replace-with-a-strong-password
REDIS_PASSWORD=replace-with-a-strong-password
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-with-a-strong-password

DASHSCOPE_API_KEY=replace-me
ZHIPU_API_KEY=replace-me
SILICONFLOW_API_KEY=replace-me

# Optional model/provider overrides
MODEL_MAIN=qwen3-max
MODEL_VERIFY=glm-4.6

# Compose service names: do not use 127.0.0.1 from inside the app container.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_DB=rag_service
NEO4J_HOST=neo4j

# Redis is provisioned but currently not consumed by the Python app.
REDIS_HOST=redis
REDIS_PORT=6379

# Feishu is optional; keep disabled until credentials and permissions are verified.
FEISHU_ENABLED=false
FEISHU_APP_ID=replace-me
FEISHU_APP_SECRET=replace-me
FEISHU_APPROVAL_ENABLED=false
FEISHU_VERIFICATION_TOKEN=replace-me
FEISHU_ENCRYPT_KEY=replace-me
FEISHU_APPROVAL_CODE_LEAVE=
FEISHU_APPROVAL_CODE_EXPENSE=
FEISHU_APPROVAL_CODE_TRAVEL=
FEISHU_APPROVAL_CODE_PURCHASE=
FEISHU_APPROVAL_CODE_CONTRACT=
