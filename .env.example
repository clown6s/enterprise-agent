# ============================================================
# enterprise-agent 环境变量
# 用法：cp .env.example .env && vi .env
# 密码：openssl rand -base64 32
# ============================================================

# ---- 模型 API Key ----
# DeepSeek（生成主力）https://platform.deepseek.com/
DEEPSEEK_API_KEY=replace-me

# 智谱 GLM（校验裁判 + OCR 多模态）https://open.bigmodel.cn/
ZHIPU_API_KEY=replace-me

# 硅基流动（嵌入 + 重排）https://siliconflow.cn/
SILICONFLOW_API_KEY=replace-me

# ---- 数据库密码（Docker Compose 基础设施容器也读这些）----
MYSQL_ROOT_PASSWORD=replace-with-strong-password
NEO4J_PASSWORD=replace-with-strong-password
REDIS_PASSWORD=replace-with-strong-password

# ---- 飞书 ----
# 本地开发或 Docker 部署都需要
FEISHU_ENABLED=true
FEISHU_APP_ID=replace-me
FEISHU_APP_SECRET=replace-me

# 飞书告警机器人（watchdog 用，可选）
FEISHU_ALERT_WEBHOOK_URL=

# ---- 飞书原生审批（方案 A，默认关闭）----
FEISHU_APPROVAL_ENABLED=false
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_APPROVAL_CODE_LEAVE=
FEISHU_APPROVAL_CODE_EXPENSE=
FEISHU_APPROVAL_CODE_TRAVEL=
FEISHU_APPROVAL_CODE_PURCHASE=
FEISHU_APPROVAL_CODE_CONTRACT=

# ============================================================
# 以下仅在本地 python run.py 开发时使用
# Docker 部署时由 docker-compose.yml environment: 覆盖
# ============================================================

MYSQL_HOST=10.211.55.5
MYSQL_PORT=3306
MILVUS_HOST=10.211.55.5
MILVUS_PORT=19530
MILVUS_DB=rag_service
NEO4J_HOST=10.211.55.5
REDIS_HOST=10.211.55.5
REDIS_PORT=6379
